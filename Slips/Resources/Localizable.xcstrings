    "automation.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts can send waiting slips as soon as your iPhone joins your home Wi-Fi, so a server on that network gets them without opening the app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis peut envoyer les reçus en attente dès que votre iPhone rejoint le Wi-Fi de la maison; un serveur sur ce réseau les reçoit sans que vous ouvriez l’app."
          }
        }
      }
    },
    "automation.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app’s own background refresh also sends slips, but iOS decides when it runs."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actualisation en arrière-plan de l’app envoie aussi les reçus, mais c’est iOS qui décide quand."
          }
        }
      }
    },
