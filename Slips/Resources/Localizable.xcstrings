    "check.registration_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The supplier’s GST or QST number is missing. A business usually needs them to claim input tax credits and refunds above the thresholds; confirm with your accountant, CRA or Revenu Québec."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le numéro de TPS ou de TVQ du fournisseur est absent. Une entreprise en a habituellement besoin pour demander les crédits et remboursements de taxes au-delà des seuils; confirmez auprès de votre comptable, de l’ARC ou de Revenu Québec."
          }
        }
      }
    },
